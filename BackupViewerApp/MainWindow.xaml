<Window x:Class="BackupViewerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone Backup Viewer"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="OpenFolderButton"
                        Content="Open Backup Folder"
                        Width="170"
                        Height="36"
                        Margin="0,0,12,0"
                        Click="OpenFolderButton_Click"/>
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        Width="120"
                        Height="36"
                        Click="RefreshButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Backup Folder" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding BackupPath}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="FileGrid"
                      AutoGenerateColumns="False"
                      AlternatingRowBackground="#F8F8F8"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      SelectionChanged="FileGrid_SelectionChanged"
                      ItemsSource="{Binding Files}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/>
                    <DataGridTextColumn Header="Encrypted" Binding="{Binding IsEncrypted}" Width="90"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="12,0,0,0" Background="#F9F9F9" BorderBrush="#D9D9D9" BorderThickness="1" Padding="12" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected File" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding DetailsText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding FileCount, StringFormat='Files: {0}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
